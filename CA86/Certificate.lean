import Init

namespace CA86

/-- The 3440 original entries, as two-bit digits in row-major order. -/
def packedCertificate : Nat :=
  

/-- The original matrix, decoded from its immutable packed numeral. -/
def certificate (r : Fin 86) (c : Fin 40) : Fin 3 :=
  ⟨((packedCertificate >>> (2 * (r.val * 40 + c.val))) &&& 3) % 3,
    Nat.mod_lt _ (by decide)⟩

end CA86
