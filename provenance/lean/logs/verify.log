def CA86.IsCoveringArray : {n k v : Nat} → (Fin n → Fin k → Fin v) → Prop :=
fun {n k v} A => ∀ (i j l : Fin k), i < j → j < l → ∀ (a b c : Fin v), ∃ r, A r i = a ∧ A r j = b ∧ A r l = c
def CA86.CAN₃ : Nat → Nat → Nat :=
fun k v => if h : ∃ n, CA86.Feasible n k v then Classical.choose ⋯ else 0
